# Copiar como .env y completar localmente. Node >=22. No subir .env a Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATAMART_DATABASE_URL=
DATAMART_SCHEMA=public
BDOO_DATABASE_URL=
BDOO_SCHEMA=public
PGSSL=require
# CA pública incluida; ruta relativa a Agente_P3 o ruta absoluta al PEM:
PGSSLROOTCERT=certs/prod-ca-2021.crt
AGENTE_USUARIO=Equipo 01
# Opcional: ruta del ejecutable Python si "python" no funciona en PATH.
PYTHON_BIN=python
